<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_02_harmonia_approval_offer" targetNamespace="https://unlockit.io/harmonia/bpmn" exporter="Concordia V2 deterministic renderer" exporterVersion="1.0">
  <bpmn:message id="Message_HarmoniaApprovalOffer" name="Harmonia approval offer handoff" />
  <bpmn:process id="Process_HarmoniaApprovalOffer" isExecutable="false">
    <bpmn:documentation>Illustrative BPMN for a Harmonia property-financing approval and offer workflow. The Buyer provides a credential for the financing deal, the Bank or financing domain reviews the input and makes the financing decision, the Buyer submits a purchase proposal, the Seller reviews it, and the Settler settles the approved purchase.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_HarmoniaApprovalOffer">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>Start_BuyerCredential</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyerCredential</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_BuyerCredential</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_BuyerApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyerPurchaseProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_BuyerPurchaseProposal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BankFinancing" name="Bank / Financing Domain">
        <bpmn:flowNodeRef>Catch_BankInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BankReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_BankDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_13ycyx2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_04ylbhn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>Event_1wv0z29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SellerReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0w72tfc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0ag4yfr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_SellerPurchaseProposal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BuyerCredential" name="Financing deal">
      <bpmn:outgoing>Flow_CredentialStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_BuyerCredential" name="Provide credential for financing deal">
      <bpmn:incoming>Flow_CredentialStart</bpmn:incoming>
      <bpmn:outgoing>Flow_CredentialThrow</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_BuyerCredential" name="Credential provided">
      <bpmn:incoming>Flow_CredentialThrow</bpmn:incoming>
      <bpmn:outgoing>Flow_BankInput</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_BuyerCredential" messageRef="Message_HarmoniaApprovalOffer" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_BankInput" name="Credential received">
      <bpmn:incoming>Flow_BankInput</bpmn:incoming>
      <bpmn:outgoing>Flow_BankReview</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_BankInput" messageRef="Message_HarmoniaApprovalOffer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_BankReview" name="Review input for Financing decision">
      <bpmn:incoming>Flow_BankReview</bpmn:incoming>
      <bpmn:outgoing>Flow_BankDecisionThrow</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_BankDecision" name="Financing decision approved">
      <bpmn:incoming>Flow_1qnuyk1</bpmn:incoming>
      <bpmn:outgoing>Flow_0n44hdf</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_BankDecision" messageRef="Message_HarmoniaApprovalOffer" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_BuyerApproval" name="Financing decision approved received">
      <bpmn:incoming>Flow_0n44hdf</bpmn:incoming>
      <bpmn:outgoing>Flow_BuyerProposalTask</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_BuyerApproval" messageRef="Message_HarmoniaApprovalOffer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_BuyerPurchaseProposal" name="Purchase proposal">
      <bpmn:incoming>Flow_BuyerProposalTask</bpmn:incoming>
      <bpmn:outgoing>Flow_BuyerProposalThrow</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_BuyerPurchaseProposal" name="Purchase proposal sent">
      <bpmn:incoming>Flow_BuyerProposalThrow</bpmn:incoming>
      <bpmn:outgoing>Flow_09w99kp</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_BuyerPurchaseProposal" messageRef="Message_HarmoniaApprovalOffer" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Catch_SellerPurchaseProposal" name="Purchase proposal received">
      <bpmn:incoming>Flow_09w99kp</bpmn:incoming>
      <bpmn:outgoing>Flow_SellerReview</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_SellerProposal" messageRef="Message_HarmoniaApprovalOffer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SellerReview" name="Review purchase proposal">
      <bpmn:incoming>Flow_SellerReview</bpmn:incoming>
      <bpmn:outgoing>Flow_0je7wfm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_CredentialStart" sourceRef="Start_BuyerCredential" targetRef="Task_BuyerCredential" />
    <bpmn:sequenceFlow id="Flow_CredentialThrow" sourceRef="Task_BuyerCredential" targetRef="Throw_BuyerCredential" />
    <bpmn:sequenceFlow id="Flow_BankInput" sourceRef="Throw_BuyerCredential" targetRef="Catch_BankInput" />
    <bpmn:sequenceFlow id="Flow_BankReview" sourceRef="Catch_BankInput" targetRef="Task_BankReview" />
    <bpmn:sequenceFlow id="Flow_BankDecisionThrow" sourceRef="Task_BankReview" targetRef="Gateway_13ycyx2" />
    <bpmn:sequenceFlow id="Flow_BuyerProposalTask" sourceRef="Catch_BuyerApproval" targetRef="Task_BuyerPurchaseProposal" />
    <bpmn:sequenceFlow id="Flow_BuyerProposalThrow" sourceRef="Task_BuyerPurchaseProposal" targetRef="Throw_BuyerPurchaseProposal" />
    <bpmn:sequenceFlow id="Flow_SellerReview" sourceRef="Catch_SellerPurchaseProposal" targetRef="Task_SellerReview" />
    <bpmn:exclusiveGateway id="Gateway_13ycyx2" name="Decision?">
      <bpmn:incoming>Flow_BankDecisionThrow</bpmn:incoming>
      <bpmn:outgoing>Flow_1qnuyk1</bpmn:outgoing>
      <bpmn:outgoing>Flow_1d30lpn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1qnuyk1" name="approve" sourceRef="Gateway_13ycyx2" targetRef="Throw_BankDecision" />
    <bpmn:endEvent id="Event_04ylbhn">
      <bpmn:incoming>Flow_1d30lpn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1d30lpn" name="reject" sourceRef="Gateway_13ycyx2" targetRef="Event_04ylbhn" />
    <bpmn:sequenceFlow id="Flow_0n44hdf" sourceRef="Throw_BankDecision" targetRef="Catch_BuyerApproval" />
    <bpmn:sequenceFlow id="Flow_09w99kp" sourceRef="Throw_BuyerPurchaseProposal" targetRef="Catch_SellerPurchaseProposal" />
    <bpmn:exclusiveGateway id="Gateway_0ag4yfr" name="Decision?">
      <bpmn:incoming>Flow_0je7wfm</bpmn:incoming>
      <bpmn:outgoing>Flow_1ojtrzk</bpmn:outgoing>
      <bpmn:outgoing>Flow_0aw2xeq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_0w72tfc" name="Purchase Created">
      <bpmn:incoming>Flow_1ojtrzk</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_02uqgtm" messageRef="Message_HarmoniaApprovalOffer" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Event_1wv0z29">
      <bpmn:incoming>Flow_0aw2xeq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1ojtrzk" name="approve" sourceRef="Gateway_0ag4yfr" targetRef="Event_0w72tfc" />
    <bpmn:sequenceFlow id="Flow_0aw2xeq" name="reject" sourceRef="Gateway_0ag4yfr" targetRef="Event_1wv0z29" />
    <bpmn:sequenceFlow id="Flow_0je7wfm" sourceRef="Task_SellerReview" targetRef="Gateway_0ag4yfr" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HarmoniaApprovalOffer">
    <bpmndi:BPMNPlane id="BPMNPlane_HarmoniaApprovalOffer" bpmnElement="Process_HarmoniaApprovalOffer">
